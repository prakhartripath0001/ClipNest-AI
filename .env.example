# Database configuration
DATABASE_PATH=./clipnest_data

# App configuration
GLOBAL_SHORTCUT=CommandOrControl+Shift+Space
MAX_CLIPBOARD_ITEMS=100

# Screenshot configuration
AUTO_DETECT_SCREENSHOTS=true
SCREENSHOT_FOLDER=./screenshots

# OCR Configuration
OCR_ENABLED=true

# API Keys (for future integration)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
