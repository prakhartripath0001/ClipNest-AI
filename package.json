{
  "name": "clipnest-ai",
  "version": "1.0.0",
  "description": "AI-first clipboard and screenshot manager for enhanced productivity",
  "main": "index.js",
  "homepage": "./",
  "author": "ClipNest AI",
  "license": "MIT",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-test": "electron electron-test.js",
    "electron-only": "electron . --debug",
    "react-only": "npm run react-start",
    "electron-dev": "concurrently -k \"npm run react-start\" \"sleep 5 && electron .\"",
    "dev": "npm run electron-dev",
    "electron-build": "npm run react-build && electron-builder",
    "electron-build-win": "npm run react-build && electron-builder --win",
    "electron-build-mac": "npm run react-build && electron-builder --mac",
    "electron-build-linux": "npm run react-build && electron-builder --linux",
    "build": "npm run react-build",
    "start": "npm run dev",
    "pack": "electron-builder --dir",
    "dist": "npm run react-build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sqlite3": "^5.1.6",
    "tesseract.js": "^4.1.1",
    "uuid": "^9.0.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "web-vitals": "^2.1.4",
    "eslint": "^8.48.0"
  },
  "build": {
    "appId": "com.clipnest.ai",
    "productName": "ClipNest AI",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
